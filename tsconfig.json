{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": { "@ds/*": ["../bezpiecznik/08-design-system/*"] }
  },
  "include": ["src", "server", "shared", "scripts", "vite.config.ts"]
}
