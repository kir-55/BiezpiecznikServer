      "name": "Composer",
      "group": "Czat",
      "summary": "Pole wpisywania pytania — kopia proporcji ChatGPT: pigułka radius-xl (28 px), min."
    },
    {
      "name": "Message",
      "group": "Czat",
      "summary": "Wiadomość w czacie, jak w ChatGPT: użytkownik w dymku po prawej (bg-200, radius-lg 18 px, max 70% szerokości), asystent bez dymka, tekst na całą szerokość (cha…"
    },
    {
      "name": "AnswerLabel"
    },
    {
      "name": "SourceChip",
      "group": "Czat",
      "summary": "Dowód, że odpowiedź pochodzi z oficjalnego źródła: wydawca · tytuł · strona na verified-tint."
    },
    {
      "name": "Thinking",
      "group": "Czat",
      "summary": "Stan „model pracuje”: pulsująca kropka (jak w ChatGPT przed pierwszym słowem) i tekst statusu z przesuwającym się połyskiem."
    },
    {
      "name": "QuickActions",
      "group": "Czat",
      "summary": "QuickActions — siatka 2 × 2 w pustym czacie: Ktoś nie oddycha · Brak prądu · Alarm / schron · Ewakuacja."
    },
    {
      "name": "JumpToLatest"
    },
    {
      "name": "NoSource",
      "group": "Czat",
      "summary": "Spokojna odpowiedź, gdy pobrane źródła nie odpowiadają na pytanie, a sytuacja nie jest krytyczna."
    },
    {
      "name": "OfflineBadge",
      "group": "Status",
      "summary": "Stały znacznik w nagłówku: aplikacja działa bez sieci."
    },
    {
      "name": "PanelCard"
    },
    {
      "name": "StepsPanel",
      "group": "Szablony czatu",
      "summary": "Szablon steps: numerowane kroki do wykonania po kolei, w karcie PanelCard."
    },
    {
      "name": "Steps",
      "group": "Czat",
      "summary": "Zastąpiony przez StepsPanel w szablonie steps (karta, odhaczanie, źródło przy każdym kroku, warianty)."
    },
    {
      "name": "BulletsPanel",
      "group": "Szablony czatu",
      "summary": "Szablon bullets: lista bez kolejności (co zabrać, czego unikać, braki w plecaku). checkable dodaje checkbox do każdego elementu i licznik „{n} z {m}” w nagłówk…"
    },
    {
      "name": "QuotePanel",
      "group": "Szablony czatu",
      "summary": "Szablon quote i podgląd PDF: oryginalny fragment źródła bez wychodzenia z czatu."
    },
    {
      "name": "MapCard",
      "group": "Szablony czatu",
      "summary": "Szablon map: najbliższy punkt (schron, szpital, straż, woda, apteka) z odległością, czasem dojścia i kierunkiem, wejście do Mapy."
    },
    {
      "name": "CallPanel",
      "group": "Szablony czatu",
      "summary": "Wezwanie pomocy (EmergencyContactPanel ze specyfikacji): w czacie (szablon call, inline) i po dotknięciu SOS (Panel 2, sheet)."
    },
    {
      "name": "Fallback112",
      "group": "Bezpieczeństwo",
      "summary": "Zastąpiony przez CallPanel — specyfikacja ma jeden komponent wezwania pomocy (EmergencyContactPanel), używany i w czacie (szablon call), i w Panelu 2."
    },
    {
      "name": "SignalPanel",
      "group": "Szablony czatu",
      "summary": "Szablon signal: zwrócić uwagę ratowników, gdy nie da się zadzwonić."
    },
    {
      "name": "CprCard"
    },
    {
      "name": "CprPinned",
      "group": "Szablony czatu",
      "summary": "Szablon cpr, tylko w karcie RKO (bez modelu AI)."
    },
    {
      "name": "AnimationPanel",
      "group": "Szablony czatu",
      "summary": "Szablon animation, tylko w kartach ratunkowych."
    },
    {
      "name": "MapMarker"
    },
    {
      "name": "UserDot"
    },
    {
      "name": "DetailIndicator"
    },
    {
